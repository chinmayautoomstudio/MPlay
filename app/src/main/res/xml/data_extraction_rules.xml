<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+. The sign-in session and its Tink keyset are excluded:
   they are bound to this phone's Keystore and must not follow the user to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
        <exclude domain="sharedpref" path="auth_keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
        <exclude domain="sharedpref" path="auth_keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
