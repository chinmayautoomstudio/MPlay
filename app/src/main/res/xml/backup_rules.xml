<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (Android 12+ uses data_extraction_rules.xml).
   The sign-in session is encrypted with a key that lives only in this phone's Keystore, so it is never
   backed up: a restored copy couldn't be decrypted and would let a session move to another device.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    <exclude domain="sharedpref" path="auth_keyset_prefs.xml" />
</full-backup-content>
